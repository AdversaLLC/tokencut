{
  "_comment": "Merge into ~/.claude/settings.json or .claude/settings.json. Fields verified against code.claude.com/docs/en/hooks. Requires tokencut on PYTHONPATH or pip-installed.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m tokencut.cli hook-bash-pre",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m tokencut.cli hook-read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m tokencut.cli hook-bash",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m tokencut.cli hook-read-post",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m tokencut.cli hook-guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}